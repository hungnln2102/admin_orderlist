{
  "name": "admin_orderlist",
  "version": "2.0.0",
  "private": true,
  "description": "Workspace orchestrator for admin_orderlist. Runtime dependencies live inside backend/ and frontend/.",
  "scripts": {
    "dev": "npx --yes concurrently@9 -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "test:backend": "npm --prefix backend run test",
    "graph:index": "npx -y codebase-memory-mcp cli index_repository --repo-path . --persistence true",
    "graph:arch": "npx -y codebase-memory-mcp cli get_architecture --project D-Desktop-admin-admin_orderlist",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}