NODE_ENV=development
PORT=3002
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/admin_orderlist_v2
SESSION_SECRET=replace-with-a-long-random-secret
SEPAY_API_KEY=replace-with-the-sepay-webhook-api-key
CORS_ORIGINS=http://localhost:3003
# Set to 1 only when the backend is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY=0
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=replace-with-a-strong-admin-password
# Để trống để tự nhận diện theo trình duyệt người dùng (mặc định Edge). Giá trị: msedge | chrome | chromium
WAREHOUSE_BROWSER_CHANNEL=
WAREHOUSE_BROWSER_ALLOWED_HOSTS=accounts.google.com,www.netflix.com,account.adobe.com,www.canva.com,gemini.google.com,accounts.spotify.com,login.microsoftonline.com,chatgpt.com,www.google.com
WAREHOUSE_BROWSER_PROFILE_DIR=
WAREHOUSE_BROWSER_WINDOW_WIDTH=760
WAREHOUSE_BROWSER_WINDOW_HEIGHT=640
# Required: exact cookie names used to confirm a logged-in profile, comma-separated. Empty means always not logged in.
WAREHOUSE_BROWSER_SESSION_COOKIE_NAMES=idg_token
