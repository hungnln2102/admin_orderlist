{
  "name": "admin_orderlist-backend",
  "version": "2.0.0",
  "description": "Admin Order List - Backend (Clean Architecture)",
  "main": "src/server.js",
  "scripts": {
    "start": "node -r module-alias/register src/server.js",
    "dev": "nodemon -r module-alias/register src/server.js",
    "migrate": "knex migrate:latest",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node tests/run-integration.js",
    "playwright:install": "playwright install chromium"
  },
  "_moduleAliases": {
    "@": "src"
  },
  "dependencies": {
    "@google-analytics/data": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "form-data": "^4.0.6",
    "knex": "^3.1.0",
    "module-alias": "^2.2.3",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
